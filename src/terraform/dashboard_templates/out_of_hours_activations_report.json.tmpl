    {
      "type": 3,
      "name": "grid-privilege-roles-groups-activations",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Details",
        "query": "let BusinessStartHour = 7;\r\nlet BusinessEndHour = 19;\r\n\r\nlet RoleActivations = AuditLogs\r\n    | where Category == \"RoleManagement\"\r\n    | where Result =~ \"success\"\r\n    | where OperationName == \"Add member to role completed (PIM activation)\"\r\n    | mv-apply IB = InitiatedBy on (\r\n        summarize\r\n            UserDisplayName = anyif(tostring(IB.user.displayName), isnotnull(IB.user)),\r\n            UserPrincipalName = anyif(tostring(IB.user.userPrincipalName), isnotnull(IB.user)),\r\n            ApplicationDisplayName = anyif(tostring(IB.app.displayName), isnotnull(IB.app))\r\n    )\r\n    | extend Actor = case(\r\n        isnotempty(UserDisplayName) and isnotempty(UserPrincipalName), strcat(UserPrincipalName, \" (\", tostring(UserDisplayName), \")\"),\r\n        isempty(UserDisplayName) and isnotempty(UserPrincipalName), UserPrincipalName,\r\n        isnotempty(UserDisplayName) and isempty(UserPrincipalName), UserDisplayName,\r\n        isnotempty(ApplicationDisplayName), ApplicationDisplayName,\r\n        \"Unknown\"\r\n    )\r\n    | mv-apply TR = TargetResources on (\r\n        summarize Role = anyif(tostring(TR.displayName), TR.type =~ \"Role\")\r\n    )\r\n    | where Actor != \"Azure AD PIM\"\r\n    | where isnotempty(Role)\r\n    | where Role in ({Roles:value})\r\n    | extend Target = Role, Type = \"Role\";\r\n\r\nlet GroupActivations = AuditLogs\r\n    | where Category == \"GroupManagement\"\r\n    | where Result =~ \"success\"\r\n    | where OperationName == \"Add member to role completed (PIM activation)\"\r\n    | mv-apply IB = InitiatedBy on (\r\n        summarize\r\n            UserDisplayName = anyif(tostring(IB.user.displayName), isnotnull(IB.user)),\r\n            UserPrincipalName = anyif(tostring(IB.user.userPrincipalName), isnotnull(IB.user)),\r\n            ApplicationDisplayName = anyif(tostring(IB.app.displayName), isnotnull(IB.app))\r\n    )\r\n    | extend Actor = case(\r\n        isnotempty(UserDisplayName) and isnotempty(UserPrincipalName), strcat(UserPrincipalName, \" (\", tostring(UserDisplayName), \")\"),\r\n        isempty(UserDisplayName) and isnotempty(UserPrincipalName), UserPrincipalName,\r\n        isnotempty(UserDisplayName) and isempty(UserPrincipalName), UserDisplayName,\r\n        isnotempty(ApplicationDisplayName), ApplicationDisplayName,\r\n        \"Unknown\"\r\n    )\r\n    | mv-apply TR = TargetResources on (\r\n        summarize \r\n            GroupName = anyif(tostring(TR.displayName), TR.type =~ \"Group\" or TR.type =~ \"Other\")\r\n    )\r\n    | where Actor != \"Azure AD PIM\"\r\n    | where isnotempty(GroupName)\r\n    | where GroupName in ({Groups:value})\r\n    | extend Target = GroupName, Type = \"Group\";\r\n\r\nunion RoleActivations, GroupActivations\r\n| extend LocalTime = datetime_utc_to_local(TimeGenerated, 'Europe/London')\r\n| extend DOW = dayofweek(LocalTime) / 1d\r\n| extend HoursFlag = iff(hourofday(LocalTime) between (BusinessStartHour .. BusinessEndHour - 1) and DOW !in (0, 6), \"In\", \"Out\")\r\n| where '{BusinessHours}' == \"All\" or HoursFlag == '{BusinessHours}'\r\n| where '{SelectedTarget}' == 'All' or Target == '{SelectedTarget}'\r\n| order by TimeGenerated desc\r\n| project TimeGenerated, Actor, Target, Justification = ResultReason, CorrelationId",
        "size": 0,
