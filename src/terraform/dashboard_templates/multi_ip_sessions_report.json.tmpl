              "durationMs": 604800000
            }
          },
          {
            "id": "2f8b6d03-a9c1-47e5-b3d7-5e1c0a9f8b52",
            "version": "KqlParameterItem/1.0",
            "name": "MinIPs",
            "label": "Minimum Distinct IPs",
            "type": 2,
            "isRequired": true,
            "multiSelect": false,
            "isHiddenWhenLocked": false,
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "jsonData": "[\r\n{\"value\":\"2\",\"label\":\"2 or more\",\"selected\":true},\r\n{\"value\":\"3\",\"label\":\"3 or more\"},\r\n{\"value\":\"5\",\"label\":\"5 or more\"},\r\n{\"value\":\"10\",\"label\":\"10 or more\"}\r\n]",
            "key": "2f8b6d03-a9c1-47e5-b3d7-5e1c0a9f8b52",
            "value": "2"
          },
          {
            "id": "9c3e1f74-6b0a-4d2c-85e9-7a4b3d1c0e63",
            "version": "KqlParameterItem/1.0",
            "name": "CountryFilter",
            "label": "Sessions Shown",
            "type": 2,
            "isRequired": true,
            "multiSelect": false,
            "isHiddenWhenLocked": false,
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "jsonData": "[\r\n{\"value\":\"All\",\"label\":\"All sessions\",\"selected\":true},\r\n{\"value\":\"Multi\",\"label\":\"Only sessions seen in more than one country\"}\r\n]",
            "key": "9c3e1f74-6b0a-4d2c-85e9-7a4b3d1c0e63",
            "value": "All"
          },
          {
            "id": "4d7a2b18-c6e3-4f95-a0b1-3e8f6c2d9a74",
            "version": "KqlParameterItem/1.0",
            "name": "NonGBOnly",
            "label": "Non-GB Only",
            "type": 2,
            "isRequired": true,
            "multiSelect": false,
            "isHiddenWhenLocked": false,
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "jsonData": "[\r\n{\"value\":\"No\",\"label\":\"No - include GB\",\"selected\":true},\r\n{\"value\":\"Yes\",\"label\":\"Yes - non-GB sign-ins only\"}\r\n]",
            "key": "4d7a2b18-c6e3-4f95-a0b1-3e8f6c2d9a74",
            "value": "No"
          },
          {
            "id": "c5f2e8a1-9b3d-4e67-a8c0-1d4f7b2e6a39",
            "version": "KqlParameterItem/1.0",
            "name": "HideAllowlisted",
            "label": "Hide Allowlisted IPs",
            "type": 2,
            "isRequired": true,
            "multiSelect": false,
            "isHiddenWhenLocked": false,
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "jsonData": "[\r\n{\"value\":\"No\",\"label\":\"No - show all IPs\",\"selected\":true},\r\n{\"value\":\"Yes\",\"label\":\"Yes - hide allowlisted IPs\"}\r\n]",
            "key": "c5f2e8a1-9b3d-4e67-a8c0-1d4f7b2e6a39",
            "value": "No"
          },
          {
            "id": "7b1e5c92-0d4f-4a63-9e28-b5c1f7a3d806",
            "version": "KqlParameterItem/1.0",
            "name": "EmailDomains",
            "label": "Email Domains",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "isHiddenWhenLocked": false,
            "query": "union isfuzzy=true SigninLogs, AADNonInteractiveUserSignInLogs\n| where ResultType == '0'\n| where isnotempty(UserPrincipalName)\n| extend EmailDomain = tolower(iff(UserPrincipalName has '#EXT#', extract(@'_([^_]+)#EXT#', 1, UserPrincipalName), tostring(split(UserPrincipalName, '@')[1])))\n| where isnotempty(EmailDomain)\n| summarize Users = dcount(UserPrincipalName) by EmailDomain\n| order by Users desc\n| project value = EmailDomain, label = strcat(EmailDomain, ' (', Users, ' users)'), selected = false",
            "crossComponentResources": [
              "${law_resource_id}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "timeContextFromParameter": "TimeRange",
            "defaultValue": "value::all",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "key": "7b1e5c92-0d4f-4a63-9e28-b5c1f7a3d806",
            "value": [
              "value::all"
            ]
          }
        ],
        "style": "pills"
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      }
    },
    {
      "type": 3,
      "name": "pie-countries",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Successful sign-ins by country",
        "query": "union isfuzzy=true\n    (SigninLogs\n     | extend Location = todynamic(tostring(LocationDetails))),\n    (AADNonInteractiveUserSignInLogs\n     | extend Location = todynamic(tostring(LocationDetails)))\n| where ResultType == '0'\n| where isnotempty(IPAddress)\n| extend Country = tostring(Location.countryOrRegion)\n| where '{NonGBOnly}' == 'No' or (isnotempty(Country) and Country != 'GB')\n| extend EmailDomain = tolower(iff(UserPrincipalName has '#EXT#', extract(@'_([^_]+)#EXT#', 1, UserPrincipalName), tostring(split(UserPrincipalName, '@')[1])))\n| where '*' in ({EmailDomains}) or EmailDomain in ({EmailDomains})\n| where '{HideAllowlisted}' == 'No' or not(IPAddress matches regex @'${ip_allowlist_regex}')\n| summarize SignIns = count() by Country, IPAddress\n| extend CountryName = tostring(geo_info_from_ip_address(IPAddress).country)\n| summarize SignIns = sum(SignIns), CountryName = take_anyif(CountryName, isnotempty(CountryName)) by Country\n| extend Country = case(isempty(Country), 'Unknown', isempty(CountryName), Country, strcat(CountryName, ' (', Country, ')'))\n| project Country, SignIns\n| order by SignIns desc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "piechart",
        "noDataMessage": "No successful sign-ins found in the selected time range.",
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 0,
        "y": 2,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": 3,
      "name": "pie-ip-addresses",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Successful sign-ins by IP address (top 20)",
        "query": "union isfuzzy=true\n    (SigninLogs\n     | extend Location = todynamic(tostring(LocationDetails))),\n    (AADNonInteractiveUserSignInLogs\n     | extend Location = todynamic(tostring(LocationDetails)))\n| where ResultType == '0'\n| where isnotempty(IPAddress)\n| extend Country = tostring(Location.countryOrRegion)\n| where '{NonGBOnly}' == 'No' or (isnotempty(Country) and Country != 'GB')\n| extend EmailDomain = tolower(iff(UserPrincipalName has '#EXT#', extract(@'_([^_]+)#EXT#', 1, UserPrincipalName), tostring(split(UserPrincipalName, '@')[1])))\n| where '*' in ({EmailDomains}) or EmailDomain in ({EmailDomains})\n| where '{HideAllowlisted}' == 'No' or not(IPAddress matches regex @'${ip_allowlist_regex}')\n| summarize SignIns = count(), Country = take_anyif(Country, isnotempty(Country)) by IPAddress\n| top 20 by SignIns desc\n| extend IPAddress = iff(isempty(Country), IPAddress, strcat(IPAddress, ' (', Country, ')'))\n| project IPAddress, SignIns\n| order by SignIns desc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "piechart",
        "noDataMessage": "No successful sign-ins found in the selected time range.",
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 12,
        "y": 2,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": 3,
      "name": "grid-multi-ip-sessions",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Sessions used from multiple IP addresses (select a session to see its sign-ins)",
        "query": "let SignIns = union isfuzzy=true\n    (SigninLogs\n     | extend SignInType = 'Interactive',\n              Location = todynamic(tostring(LocationDetails)),\n              Device = todynamic(tostring(DeviceDetail))),\n    (AADNonInteractiveUserSignInLogs\n     | extend SignInType = 'NonInteractive',\n              Location = todynamic(tostring(LocationDetails)),\n              Device = todynamic(tostring(DeviceDetail)))\n| where ResultType == '0'\n| where isnotempty(UserId) and isnotempty(SessionId) and isnotempty(IPAddress)\n| extend Country = tostring(Location.countryOrRegion),\n         DeviceId = tostring(Device.deviceId)\n| extend EmailDomain = tolower(iff(UserPrincipalName has '#EXT#', extract(@'_([^_]+)#EXT#', 1, UserPrincipalName), tostring(split(UserPrincipalName, '@')[1])))\n| where '*' in ({EmailDomains}) or EmailDomain in ({EmailDomains})\n| extend IsAllowlisted = IPAddress matches regex @'${ip_allowlist_regex}';\nlet CountryNames = SignIns\n| where isnotempty(Country)\n| summarize by Country, IPAddress\n| extend CountryName = tostring(geo_info_from_ip_address(IPAddress).country)\n| summarize CountryName = take_anyif(CountryName, isnotempty(CountryName)) by Country;\nSignIns\n| lookup kind=leftouter CountryNames on Country\n| extend CountryLabel = iff(isempty(CountryName), Country, strcat(CountryName, ' (', Country, ')'))\n| summarize\n    FirstSeen = min(TimeGenerated),\n    LastSeen = max(TimeGenerated),\n    EventCount = count(),\n    IPCount = dcount(IPAddress),\n    AllowlistedIPCount = dcountif(IPAddress, IsAllowlisted),\n    NonAllowlistedIPCount = dcountif(IPAddress, not(IsAllowlisted)),\n    CountryCount = dcountif(Country, isnotempty(Country)),\n    NonGBCountryCount = dcountif(Country, isnotempty(Country) and Country != 'GB'),\n    DeviceCount = dcountif(DeviceId, isnotempty(DeviceId)),\n    IPAddresses = make_set(IPAddress, 20),\n    Countries = make_set_if(CountryLabel, isnotempty(Country), 20),\n    Devices = make_set_if(DeviceId, isnotempty(DeviceId), 20),\n    Applications = make_set(AppDisplayName, 20),\n    SignInTypes = make_set(SignInType, 5)\n    by UserId, UserPrincipalName, SessionId\n| where IPCount >= {MinIPs}\n| where '{CountryFilter}' == 'All' or CountryCount > 1\n| where '{NonGBOnly}' == 'No' or NonGBCountryCount > 0\n| where '{HideAllowlisted}' == 'No' or NonAllowlistedIPCount > 0\n| project UserPrincipalName, SessionId, IPCount, AllowlistedIPCount, CountryCount, DeviceCount, EventCount, FirstSeen, LastSeen, IPAddresses, Countries, Devices, Applications, SignInTypes, UserId\n| order by IPCount desc, LastSeen desc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "IPCount",
              "formatter": 8,
              "formatOptions": {
                "min": 0,
                "palette": "orange"
              }
            },
            {
              "columnMatch": "CountryCount",
              "formatter": 8,
              "formatOptions": {
                "min": 0,
                "palette": "red"
              }
            },
            {
              "columnMatch": "IPAddresses",
              "formatter": 1,
              "formatOptions": {
                "linkTarget": "CellDetails",
                "linkIsContextBlade": true
              }
            },
            {
              "columnMatch": "Devices",
              "formatter": 1,
              "formatOptions": {
                "linkTarget": "CellDetails",
                "linkIsContextBlade": true
              }
            },
            {
              "columnMatch": "Applications",
              "formatter": 1,
              "formatOptions": {
                "linkTarget": "CellDetails",
                "linkIsContextBlade": true
              }
            }
          ],
          "rowLimit": 500,
          "filter": true
        },
        "exportedParameters": [
          {
            "parameterType": 1,
            "fieldName": "SessionId",
            "parameterName": "SelectedSessionId"
          }
        ],
        "noDataMessage": "No sessions were used from multiple IP addresses in the selected time range.",
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 11
      }
    },
    {
      "type": 3,
      "name": "grid-session-signins",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Sign-ins in the selected session",
        "query": "union isfuzzy=true\n    (SigninLogs\n     | extend SignInType = 'Interactive',\n              Location = todynamic(tostring(LocationDetails)),\n              Device = todynamic(tostring(DeviceDetail))),\n    (AADNonInteractiveUserSignInLogs\n     | extend SignInType = 'NonInteractive',\n              Location = todynamic(tostring(LocationDetails)),\n              Device = todynamic(tostring(DeviceDetail)))\n| where ResultType == '0'\n| where SessionId == '{SelectedSessionId}'\n| project TimeGenerated, SignInType, UserPrincipalName, IPAddress, Allowlisted = IPAddress matches regex @'${ip_allowlist_regex}', City = tostring(Location.city), Country = tostring(Location.countryOrRegion), CountryName = tostring(geo_info_from_ip_address(IPAddress).country), AppDisplayName, ResourceDisplayName, DeviceId = tostring(Device.deviceId), Browser = tostring(Device.browser), OS = tostring(Device.operatingSystem), UserAgent, AuthenticationRequirement, ConditionalAccessStatus, CorrelationId\n| order by TimeGenerated asc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "filter": true
        },
        "noDataMessage": "No sign-ins found for the selected session.",
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 11
      },
      "conditionalVisibilities": [
        {
          "parameterName": "SelectedSessionId",
          "comparison": "isNotEqualTo",
          "value": ""
        }
      ]
    }
  ],
  "layout": {
    "type": "grid"
  },
  "styleSettings": {
    "background": "lighter"
  },
  "fallbackResourceIds": [
    "Azure Monitor"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
