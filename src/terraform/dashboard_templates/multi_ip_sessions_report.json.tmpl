    {
      "type": 3,
      "name": "pie-countries",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Successful sign-ins by country",
        "query": "union isfuzzy=true\n    (SigninLogs\n     | where '{SignInTypeFilter}' in ('Both', 'Interactive')\n     | extend Location = todynamic(tostring(LocationDetails))),\n    (AADNonInteractiveUserSignInLogs\n     | where '{SignInTypeFilter}' in ('Both', 'NonInteractive')\n     | extend Location = todynamic(tostring(LocationDetails)))\n| where ResultType == '0'\n| where isnotempty(IPAddress)\n| extend Country = tostring(Location.countryOrRegion)\n| where '{NonGBOnly}' == 'No' or (isnotempty(Country) and Country != 'GB')\n| extend EmailDomain = tolower(iff(UserPrincipalName has '#EXT#', extract(@'_([^_]+)#EXT#', 1, UserPrincipalName), tostring(split(UserPrincipalName, '@')[1])))\n| where '*' in ({EmailDomains}) or EmailDomain in ({EmailDomains})\n| where '{HideAllowlisted}' == 'No' or not(${ip_allowlist_condition})\n| summarize SignIns = count() by Country, IPAddress\n| extend CountryName = tostring(geo_info_from_ip_address(IPAddress).country)\n| summarize SignIns = sum(SignIns), CountryName = take_anyif(CountryName, isnotempty(CountryName)) by Country\n| extend Country = case(isempty(Country), 'Unknown', isempty(CountryName), Country, strcat(CountryName, ' (', Country, ')'))\n| project Country, SignIns\n| order by SignIns desc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "piechart",
        "noDataMessage": "No successful sign-ins found in the selected time range.",
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": 3,
      "name": "pie-ip-addresses",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Successful sign-ins by IP address (top 20)",
        "query": "union isfuzzy=true\n    (SigninLogs\n     | where '{SignInTypeFilter}' in ('Both', 'Interactive')\n     | extend Location = todynamic(tostring(LocationDetails))),\n    (AADNonInteractiveUserSignInLogs\n     | where '{SignInTypeFilter}' in ('Both', 'NonInteractive')\n     | extend Location = todynamic(tostring(LocationDetails)))\n| where ResultType == '0'\n| where isnotempty(IPAddress)\n| extend Country = tostring(Location.countryOrRegion)\n| where '{NonGBOnly}' == 'No' or (isnotempty(Country) and Country != 'GB')\n| extend EmailDomain = tolower(iff(UserPrincipalName has '#EXT#', extract(@'_([^_]+)#EXT#', 1, UserPrincipalName), tostring(split(UserPrincipalName, '@')[1])))\n| where '*' in ({EmailDomains}) or EmailDomain in ({EmailDomains})\n| where '{HideAllowlisted}' == 'No' or not(${ip_allowlist_condition})\n| summarize SignIns = count(), Country = take_anyif(Country, isnotempty(Country)) by IPAddress\n| top 20 by SignIns desc\n| extend IPAddress = iff(isempty(Country), IPAddress, strcat(IPAddress, ' (', Country, ')'))\n| project IPAddress, SignIns\n| order by SignIns desc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "piechart",
        "noDataMessage": "No successful sign-ins found in the selected time range.",
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": 3,
      "name": "grid-multi-ip-sessions-both",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Users with sessions used from multiple IP addresses (select a user to see their sign-ins)",
        "query": "let SignIns = union isfuzzy=true\n    (SigninLogs\n     | where '{SignInTypeFilter}' in ('Both', 'Interactive')\n     | extend SignInType = 'Interactive',\n              Location = todynamic(tostring(LocationDetails)),\n              Device = todynamic(tostring(DeviceDetail))),\n    (AADNonInteractiveUserSignInLogs\n     | where '{SignInTypeFilter}' in ('Both', 'NonInteractive')\n     | extend SignInType = 'NonInteractive',\n              Location = todynamic(tostring(LocationDetails)),\n              Device = todynamic(tostring(DeviceDetail)))\n| where ResultType == '0'\n| where isnotempty(UserId) and isnotempty(SessionId) and isnotempty(IPAddress)\n| extend Country = tostring(Location.countryOrRegion),\n         DeviceId = tostring(Device.deviceId)\n| extend EmailDomain = tolower(iff(UserPrincipalName has '#EXT#', extract(@'_([^_]+)#EXT#', 1, UserPrincipalName), tostring(split(UserPrincipalName, '@')[1])))\n| where '*' in ({EmailDomains}) or EmailDomain in ({EmailDomains})\n| extend IsAllowlisted = ${ip_allowlist_condition};\nlet MatchingSessions = SignIns\n| summarize\n    IPCount = dcount(IPAddress),\n    NonAllowlistedIPCount = dcountif(IPAddress, not(IsAllowlisted)),\n    CountryCount = dcountif(Country, isnotempty(Country)),\n    NonGBCountryCount = dcountif(Country, isnotempty(Country) and Country != 'GB')\n    by UserId, SessionId\n| where IPCount >= {MinIPs}\n| where '{CountryFilter}' == 'All' or CountryCount > 1\n| where '{NonGBOnly}' == 'No' or NonGBCountryCount > 0\n| where '{HideAllowlisted}' == 'No' or NonAllowlistedIPCount > 0\n| project UserId, SessionId;\nlet CountryNames = SignIns\n| where isnotempty(Country)\n| summarize by Country, IPAddress\n| extend CountryName = tostring(geo_info_from_ip_address(IPAddress).country)\n| summarize CountryName = take_anyif(CountryName, isnotempty(CountryName)) by Country;\nMatchingSessions\n| join kind=inner SignIns on UserId, SessionId\n| lookup kind=leftouter CountryNames on Country\n| extend CountryLabel = iff(isempty(CountryName), Country, strcat(CountryName, ' (', Country, ')'))\n| summarize\n    FirstSeen = min(TimeGenerated),\n    LastSeen = max(TimeGenerated),\n    EventCount = count(),\n    SessionCount = dcount(SessionId),\n    IPCount = dcount(IPAddress),\n    AllowlistedIPCount = dcountif(IPAddress, IsAllowlisted),\n    CountryCount = dcountif(Country, isnotempty(Country)),\n    DeviceCount = dcountif(DeviceId, isnotempty(DeviceId)),\n    SessionIds = make_set(SessionId, 100),\n    IPAddresses = make_set(IPAddress, 20),\n    Countries = make_set_if(CountryLabel, isnotempty(Country), 20),\n    Devices = make_set_if(DeviceId, isnotempty(DeviceId), 20),\n    Applications = make_set(AppDisplayName, 20),\n    SignInTypes = make_set(SignInType, 5)\n    by UserId, UserPrincipalName\n| extend SelectedSessionIds = strcat_array(SessionIds, ',')\n| extend UserPrincipalName = iff('{SprintReviewMode}' == 'On' and isnotempty(UserPrincipalName), strcat('User-', substring(hash_sha256(tolower(UserPrincipalName)), 0, 8)), UserPrincipalName)\n| project UserPrincipalName, SessionCount, IPCount, AllowlistedIPCount, CountryCount, Countries, DeviceCount, EventCount, FirstSeen, LastSeen, IPAddresses, SessionIds, Devices, Applications, SignInTypes, UserId, SelectedSessionIds\n| order by CountryCount desc, IPCount desc, LastSeen desc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "IPCount",
              "formatter": 8,
              "formatOptions": {
                "min": 0,
                "palette": "orange"
              }
            },
