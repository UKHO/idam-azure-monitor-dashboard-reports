        "title": "Sign-ins in the selected user's multi-IP sessions",
        "query": "union isfuzzy=true\n    (SigninLogs\n     | where '{SignInTypeFilter}' in ('Both', 'Interactive')\n     | extend Raw = pack_all(true)\n     | extend SignInType = 'Interactive',\n              Location = todynamic(tostring(LocationDetails)),\n              Device = todynamic(tostring(DeviceDetail))),\n    (AADNonInteractiveUserSignInLogs\n     | where '{SignInTypeFilter}' in ('Both', 'NonInteractive')\n     | extend Raw = pack_all(true)\n     | extend SignInType = 'NonInteractive',\n              Location = todynamic(tostring(LocationDetails)),\n              Device = todynamic(tostring(DeviceDetail)))\n| where ResultType == '0'\n| where SessionId in (split('{SelectedSessionIds}', ','))\n| where '{NonGBOnly}' == 'No' or (isnotempty(tostring(Location.countryOrRegion)) and tostring(Location.countryOrRegion) != 'GB')\n| extend Raw = iff('{SprintReviewMode}' == 'On', dynamic(null), Raw)\n| extend UserPrincipalName = iff('{SprintReviewMode}' == 'On' and isnotempty(UserPrincipalName), strcat('User-', substring(hash_sha256(tolower(UserPrincipalName)), 0, 8)), UserPrincipalName)\n| project TimeGenerated, SessionId, SignInType, UserPrincipalName, IPAddress, Allowlisted = ${ip_allowlist_condition}, City = tostring(Location.city), Country = tostring(Location.countryOrRegion), CountryName = tostring(geo_info_from_ip_address(IPAddress).country), AppDisplayName, ResourceDisplayName, DeviceId = tostring(Device.deviceId), Browser = tostring(Device.browser), OS = tostring(Device.operatingSystem), UserAgent, AuthenticationRequirement, ConditionalAccessStatus, CorrelationId, Raw\n| order by TimeGenerated asc",
