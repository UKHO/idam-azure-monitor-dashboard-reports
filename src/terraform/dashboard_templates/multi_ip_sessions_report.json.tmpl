{
  "version": "Notebook/1.0",
  "name": "Multi-IP Sessions Report",
  "items": [
    {
      "type": 9,
      "name": "global-parameters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "e1a4c7b9-3d52-4e08-8b6f-9c0d2a7e5f41",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time Range",
            "type": 4,
            "isRequired": true,
            "multiSelect": false,
            "isHiddenWhenLocked": false,
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
