              }
            },
            {
              "columnMatch": "Applications",
              "formatter": 1,
              "formatOptions": {
                "linkTarget": "CellDetails",
                "linkIsContextBlade": true
              }
            },
            {
              "columnMatch": "SessionIds",
              "formatter": 1,
              "formatOptions": {
                "linkTarget": "CellDetails",
                "linkIsContextBlade": true
              }
            },
            {
              "columnMatch": "SelectedSessionIds",
              "formatter": 5
            }
          ],
          "rowLimit": 500,
          "filter": true,
          "sortBy": [
            {
              "itemKey": "CountryCount",
              "sortOrder": 2
            }
          ]
        },
        "sortBy": [
          {
            "itemKey": "CountryCount",
            "sortOrder": 2
          }
        ],
        "exportedParameters": [
          {
            "parameterType": 1,
            "fieldName": "SelectedSessionIds",
            "parameterName": "SelectedSessionIds"
          }
        ],
        "noDataMessage": "No users had sessions used from multiple IP addresses in the selected time range.",
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 11
