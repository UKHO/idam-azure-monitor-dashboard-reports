{
  "version": "Notebook/1.0",
  "name": "Unapproved Browser Sign-ins Report",
  "items": [
    {
      "type": 9,
      "name": "global-parameters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "5b0c6f3e-2f1a-4d6b-9a57-1c8e4d7b2a10",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time Range",
            "type": 4,
            "isRequired": true,
            "multiSelect": false,
            "isHiddenWhenLocked": false,
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            },
            "timeContextFromParameter": null,
            "key": "5b0c6f3e-2f1a-4d6b-9a57-1c8e4d7b2a10",
            "value": {
              "durationMs": 604800000
            }
          },
          {
            "id": "7d2e9a14-8c3b-4f60-b1a5-3e9f6c0d4b21",
            "version": "KqlParameterItem/1.0",
            "name": "MfaFilter",
            "label": "Browsers Shown",
            "type": 2,
            "isRequired": true,
            "multiSelect": false,
            "isHiddenWhenLocked": false,
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "jsonData": "[\r\n{\"value\":\"All\",\"label\":\"All unapproved browsers\",\"selected\":true},\r\n{\"value\":\"NoMfa\",\"label\":\"Only where MFA was not used\"}\r\n]",
            "key": "7d2e9a14-8c3b-4f60-b1a5-3e9f6c0d4b21",
            "value": "All"
          },
          {
            "id": "c4a81e55-1b7d-49e2-8f36-6a2d0b9e5c32",
            "version": "KqlParameterItem/1.0",
            "name": "ApprovedBrowsers",
            "label": "Approved Browsers",
            "type": 2,
            "isRequired": false,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "isHiddenWhenLocked": true,
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "showDefault": false
            },
            "jsonData": "[\r\n{\"value\":\"Chrome\",\"label\":\"Chrome\"},\r\n{\"value\":\"Edge\",\"label\":\"Edge\"},\r\n{\"value\":\"Firefox\",\"label\":\"Firefox\"},\r\n{\"value\":\"Safari\",\"label\":\"Safari\"},\r\n{\"value\":\"Mobile Safari\",\"label\":\"Mobile Safari\"}\r\n]",
            "defaultValue": "value::all",
            "key": "c4a81e55-1b7d-49e2-8f36-6a2d0b9e5c32"
          }
        ],
        "style": "pills"
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      }
    },
    {
      "type": 3,
      "name": "grid-unapproved-browsers",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Unapproved Browsers (select a browser to see its sign-ins)",
        "query": "SigninLogs\n| where ResultType == '0'\n| extend Browser = tostring(DeviceDetail.browser)\n| extend BrowserFamily = iff(isempty(Browser), 'Unknown', trim(' ', extract(@'^([^\\d]+)', 1, Browser)))\n| where BrowserFamily !in ({ApprovedBrowsers:value})\n| extend AuthDetails = tostring(AuthenticationDetails)\n| extend MfaStatus = case(\n    AuthDetails has 'MFA completed', 'MFA completed',\n    AuthDetails has_any ('FIDO2 security key', 'Windows Hello for Business', 'Certificate-based authentication'), 'Strong credential',\n    AuthDetails has 'MFA requirement satisfied by claim in the token', 'MFA via token claim',\n    'MFA not used')\n| summarize SignIns = count(), Users = dcount(UserPrincipalName), SignInsWithoutMfa = countif(MfaStatus == 'MFA not used'), Versions = strcat_array(make_set(Browser, 10), ', ') by BrowserFamily\n| extend MFA = iff(SignInsWithoutMfa > 0, 'MFA not used', 'MFA used')\n| where '{MfaFilter}' == 'All' or SignInsWithoutMfa > 0\n| project BrowserFamily, SignIns, Users, MFA, SignInsWithoutMfa, Versions\n| order by SignInsWithoutMfa desc, SignIns desc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "MFA",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "MFA not used",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "SignInsWithoutMfa",
              "formatter": 8,
              "formatOptions": {
                "min": 0,
                "palette": "red"
              }
            }
          ],
          "rowLimit": 250,
          "filter": true
        },
        "exportedParameters": [
          {
            "parameterType": 1,
            "fieldName": "BrowserFamily",
            "parameterName": "SelectedBrowser"
          }
        ],
        "noDataMessage": "No sign-ins from unapproved browsers were found in the selected time range.",
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": 3,
      "name": "grid-browser-signins",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Sign-ins for the selected browser",
        "query": "SigninLogs\n| where ResultType == '0'\n| extend Browser = tostring(DeviceDetail.browser)\n| extend BrowserFamily = iff(isempty(Browser), 'Unknown', trim(' ', extract(@'^([^\\d]+)', 1, Browser)))\n| where BrowserFamily == '{SelectedBrowser}'\n| extend AuthDetails = tostring(AuthenticationDetails)\n| extend MfaStatus = case(\n    AuthDetails has 'MFA completed', 'MFA completed',\n    AuthDetails has_any ('FIDO2 security key', 'Windows Hello for Business', 'Certificate-based authentication'), 'Strong credential',\n    AuthDetails has 'MFA requirement satisfied by claim in the token', 'MFA via token claim',\n    'MFA not used')\n| where '{MfaFilter}' == 'All' or MfaStatus == 'MFA not used'\n| project TimeGenerated, UserPrincipalName, UserType, AppDisplayName, ResourceDisplayName, IPAddress, City = tostring(LocationDetails.city), Country = tostring(LocationDetails.countryOrRegion), OS = tostring(DeviceDetail.operatingSystem), Browser, Compliant = tostring(DeviceDetail.isCompliant), TrustType = tostring(DeviceDetail.trustType), MfaStatus, ConditionalAccessStatus, CorrelationId\n| order by TimeGenerated desc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "MfaStatus",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "MFA not used",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "rowLimit": 500,
          "filter": true
        },
        "exportedParameters": [
          {
            "parameterType": 1,
            "fieldName": "CorrelationId",
            "parameterName": "SelectedCorrelationId"
          }
        ],
        "noDataMessage": "No sign-ins found for the selected browser.",
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "conditionalVisibilities": [
        {
          "parameterName": "SelectedBrowser",
          "comparison": "isNotEqualTo",
          "value": ""
        }
      ]
    },
    {
      "type": 3,
      "name": "grid-signin-correlationid",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Authentication and conditional access detail",
        "query": "SigninLogs\n| where CorrelationId == '{SelectedCorrelationId}'\n| project TimeGenerated, UserPrincipalName, ResultType, ResultDescription, AuthenticationRequirement, AuthenticationDetails, ConditionalAccessStatus, ConditionalAccessPolicies\n| order by TimeGenerated asc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "AuthenticationDetails",
              "formatter": 1,
              "formatOptions": {
                "linkTarget": "CellDetails",
                "linkIsContextBlade": true
              }
            },
            {
              "columnMatch": "ConditionalAccessPolicies",
              "formatter": 1,
              "formatOptions": {
                "linkTarget": "CellDetails",
                "linkIsContextBlade": true
              }
            }
          ]
        },
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "conditionalVisibilities": [
        {
          "parameterName": "SelectedBrowser",
          "comparison": "isNotEqualTo",
          "value": ""
        },
        {
          "parameterName": "SelectedCorrelationId",
          "comparison": "isNotEqualTo",
          "value": ""
        }
      ]
    }
  ],
  "layout": {
    "type": "grid"
  },
  "styleSettings": {
    "background": "lighter"
  },
  "fallbackResourceIds": [
    "Azure Monitor"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
