    {
      "type": 3,
      "name": "pim-users-made-permanent-grid",
      "content": {
        "version": "KqlItem/1.0",
        "title": "",
        "query": "AuditLogs\n| where Category =~ \"RoleManagement\"\n| where OperationName == \"Add member to role in PIM completed (permanent)\"\n| where Result =~ \"success\"\n| mv-apply TR = TargetResources on (\n    summarize\n        Role = anyif(tostring(TR.displayName), TR.type =~ \"Role\"),\n        UserName = anyif(tostring(TR.displayName), TR.type =~ \"User\"),\n        UserEmail = anyif(tostring(TR.userPrincipalName), TR.type =~ \"User\"),\n        GroupName = anyif(tostring(TR.displayName), TR.type =~ \"Group\"),\n        ServicePrincipalName = anyif(tostring(TR.displayName), TR.type =~ \"ServicePrincipal\")\n  )\n| extend TargetEntityName = case(\n    isnotempty(GroupName), GroupName,\n    isnotempty(UserEmail), strcat(UserEmail, \" (\", UserName, \")\"),\n    isnotempty(UserName), UserName,\n    isnotempty(ServicePrincipalName), ServicePrincipalName,\n    \"Unknown\"\n  )\n  | mv-apply IB = InitiatedBy on (\n      summarize\n          UserDisplayName = anyif(tostring(IB.user.displayName), isnotnull(IB.user)),\n          UserPrincipalName = anyif(tostring(IB.user.userPrincipalName), isnotnull(IB.user)),\n          ApplicationDisplayName = anyif(tostring(IB.app.displayName), isnotnull(IB.app))\n  )\n  | extend Actor = case(\n      isnotempty(UserDisplayName) and isnotempty(UserPrincipalName), strcat(UserPrincipalName, \" (\", tostring(UserDisplayName), \")\"),\n      isempty(UserDisplayName) and isnotempty(UserPrincipalName), UserPrincipalName,\n      isnotempty(UserDisplayName) and isempty(UserPrincipalName), UserDisplayName,\n      isnotempty(ApplicationDisplayName), ApplicationDisplayName,\n      \"Unknown\"\n  )\n| project TimeGenerated, TargetEntityName, Role, ResultDescription, Actor, CorrelationId\n| sort by TimeGenerated desc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "${law_resource_id}"
        ],
        "timeContextFromParameter": "TimeRange",
