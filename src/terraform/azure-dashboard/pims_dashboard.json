    {
      "type": 3,
      "name": "pim-users-made-permanent-stat",
      "content": {
        "version": "KqlItem/1.0",
        "title": "",
        "query": "AuditLogs\n| where Category =~ \"RoleManagement\"\n| where OperationName == \"Add member to role in PIM completed (permanent)\"\n| count",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          ""
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "stat",
        "textSettings": {
          "style": "bignumber"
        },
        "showViewButton": false
      },
      "styleSettings": {
        "showBorder": false,
        "borderStyle": "light thick",
        "w": 3,
        "h": 9,
        "x": 0,
        "y": 3
      }
    },
    {
      "type": 3,
      "name": "pim-users-made-permanent-grid",
      "content": {
        "version": "KqlItem/1.0",
        "title": "",
        "query": "AuditLogs\n| where Category =~ \"RoleManagement\"\n| where OperationName == \"Add member to role in PIM completed (permanent)\"\n| extend Role = tostring(TargetResources[0].displayName)\n| mv-apply TR = TargetResources on (\n    summarize\n        UserName = anyif(tostring(TR.displayName), TR.type =~ \"User\"),\n        UserEmail = anyif(tostring(TR.userPrincipalName), TR.type =~ \"User\"),\n        GroupName = anyif(tostring(TR.displayName), TR.type =~ \"Group\"),\n        HasUser = countif(TR.type =~ \"User\") > 0\n  )\n| where {OnlyUsersParameter} == false or HasUser == true\n| extend TargetEntityName = case(\n    isnotempty(GroupName), GroupName,\n    isnotempty(UserName) and isnotempty(UserEmail), strcat(UserEmail, \" (\", UserName, \")\"),\n    isnotempty(UserEmail), UserEmail,\n    \"\"\n  )\n| extend Actor = strcat(InitiatedBy.user.userPrincipalName, \" (\", InitiatedBy.user.displayName, \")\")\n| project TimeGenerated, TargetEntityName, Role, ResultDescription, Actor, CorrelationId\n| sort by TimeGenerated desc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          ""
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "table",
        "textSettings": {
          "style": "bignumber"
        },
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "TimeGenerated",
              "formatter": 0
            }
          ],
          "rowLimit": 250,
          "filter": false
        },
        "headingLevel": 3,
        "showViewButton": false,
        "exportedParameters": [
          {
            "parameterType": 1,
            "fieldName": "CorrelationId",
            "parameterName": "PIMUsersMadePermanentCorrelationID"
          }
        ],
        "noDataMessage": "No members added to role in PIM occurred in the selected time range."
      },
      "styleSettings": {
        "showBorder": false,
        "borderStyle": "light thick",
        "w": 21,
        "h": 9,
        "x": 3,
        "y": 3
      }
    },
