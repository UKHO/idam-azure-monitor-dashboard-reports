      "type": 3,
      "name": "rbac-assignments-to-users-stat",
      "content": {
        "version": "KqlItem/1.0",
        "title": "",
        "query": "AzureActivity\r\n| where OperationNameValue contains \"MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE\"\r\n| where ActivityStatusValue contains \"Success\"\r\n| extend authorizationJson = parse_json(Authorization)\r\n| extend\r\n    PrincipalType = tostring(authorizationJson.evidence.principalType),\r\n    Role = tostring(authorizationJson.evidence.role),\r\n    RoleAssignmentScope = tostring(authorizationJson.evidence.roleAssignmentScope)\r\n| where PrincipalType =~ \"User\"\r\n| count",
        "size": 0,
        "queryType": 0,
